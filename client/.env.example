# Copy to client/.env and fill in. VITE_* values are bundled into the browser — never put secrets here.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (safe for the browser; RLS protects the data)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Express API base URL (local: http://localhost:3001, prod: your server Vercel URL)
VITE_API_URL=http://localhost:3001
