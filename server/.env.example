# Copy to server/.env and fill in. Never commit the real .env.

# Supabase project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key — used with the user's token for per-request clients (RLS applies)
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Bypasses RLS. Used only for admin operations (account deletion).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY. Anthropic API key for Claude.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Exact origin of the React app, used for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Local dev port (ignored on Vercel)
PORT=3001
